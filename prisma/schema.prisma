generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

model Blog {
  id          Int    @id @default(autoincrement())
  tag         String
  title       String
  description String
  imageurl String?
  datecreated DateTime @default(now())
  dateupdated DateTime @default(now())
  readcount Int @default(0)
}

model Message {
  id         Int    @id @default(autoincrement())
  first_name String
  last_name  String
  email      String
  phone      String
  message    String
}

model Sitevisit {
  id    Int @id @default(autoincrement())
  count Int @default(1)
}

model User {
  id    Int @id @default(autoincrement())
  email     String   @unique
  password  String?
}
