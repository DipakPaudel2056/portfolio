generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Blog {
  id          Int    @id @default(autoincrement())
  tag         String
  title       String
  description String
}

model Message {
  id         Int    @id @default(autoincrement())
  first_name String
  last_name  String
  email      String
  phone      String
  message    String
}

model Sitevisit {
  id    Int @id @default(autoincrement())
  count Int
}
